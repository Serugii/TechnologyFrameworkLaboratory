{
  "name": "framework_technology",
  "version": "1.0.0",
  "description": "Lab project",
  "main": "app.js",
  "imports": {
    "#controllers": "./src/controllers/device.controller.js",
    "#services": "./src/services/device.service.js",
    "#repositories": "./src/repositories/device.repository.js",
    "#models": "./src/models/item.model.js",
    "#schemas": "./src/schemas/device.schema.js",
    "#constants": "./src/constants/errors.js",
    "#routes": "./src/routes/device.routes.js",
    "#utils/*": "./src/utils/*",
    "#transforms/*": "./src/transforms/*",
    "#events": "./src/events/device.events.js"
  },
  "scripts": {
    "start": "node --env-file=.env app.js",
    "dev": "node --watch --env-file=.env app.js",
    "predev": "npm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "seed": "node src/scripts/seed.js",
    "migrate": "node src/migrations/migrate.js",
    "external": "json-server db.json --port 3001"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serugii/TechnologyFrameworkLaboratory.git"
  },
  "keywords": [],
  "author": "Serhii",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Serugii/TechnologyFrameworkLaboratory/issues"
  },
  "homepage": "https://github.com/Serugii/TechnologyFrameworkLaboratory#readme",
  "devDependencies": {
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "json-server": "^1.0.0-beta.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fastify": "^5.8.4"
  }
}
